# ─────────────────────────────────────────────────────────────
# MotoStar environment variables
# Copy to .env.local (development) or set in your hosting provider.
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public canonical URL of the store (no trailing slash). Used for canonical
# tags, sitemap, Open Graph and payment redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string.
DATABASE_URL=postgres://postgres@localhost:5432/motostar

# 32+ random characters. Used to sign cart/order cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# ── Payments ────────────────────────────────────────────────
# "mock"    → development/test only. Refused when NODE_ENV=production
# A production build refuses test payments (mock OR the PayPlus sandbox) unless
# ALLOW_TEST_PAYMENTS=true AND the site URL is localhost or a *.vercel.app preview.
# "payplus" → PayPlus hosted payment page (requires the keys below).
PAYMENT_PROVIDER=mock
PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_PAYMENT_PAGE_UID=
# Required with payplus. Sandbox: https://restapidev.payplus.co.il   Live: https://restapi.payplus.co.il
PAYPLUS_BASE_URL=

# ── Email ───────────────────────────────────────────────────
# "log"    → emails are stored in the email_outbox table only (development).
# "resend" → sent through Resend (https://resend.com). Requires a verified domain.
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM="Moto Star <orders@motostar.co.il>"
# Where new-order notifications for the shop are sent.
STORE_NOTIFICATION_EMAIL=motostarmail@gmail.com

# ── Uploads ─────────────────────────────────────────────────
# Where product images uploaded in the admin are stored.
# "local"       → files on disk in UPLOAD_DIR (VPS / Docker with a persistent volume, development).
# "vercel-blob" → Vercel Blob. Required on Vercel (its disk is not persistent).
STORAGE_PROVIDER=local
UPLOAD_DIR=storage/uploads
BLOB_READ_WRITE_TOKEN=

# ── Tests (optional) ───────────────────────────────────────
# Throw-away databases rebuilt by `npm test` and `npm run test:e2e` (names must end in _test / _e2e).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/motostar_test
# E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5432/motostar_e2e
